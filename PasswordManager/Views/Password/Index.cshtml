@model List<PasswordEntry>

<h3 class="fw-semibold mb-4 text-center">Saved Passwords</h3>

@if (Model.Count < 1)
{
    <p>No Passwords Saved Yet</p>
}
else
{
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th scope="col" class="py-3 ps-4">Company</th>
                <th scope="col" class="py-3">Password</th>
                <th scope="col" class="py-3 text-end pe-4">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td class="fw-semibold ps-4">@p.Company</td>
                    <td class="fw-semibold ps-4">@p.Password</td>
                    <td class="text-end pe-4">
                        <a asp-controller="Password" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-success btn-sm"> 
                            Edit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
