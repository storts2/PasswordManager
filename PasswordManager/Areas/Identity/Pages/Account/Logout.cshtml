@page
@model LogoutModel

@{
    ViewData["Title"] = "Logout";
}

<div class="container d-flex flex-grow-1 justify-content-center align-items-center p-4">
    <div class="col-md-6 col-lg-5">

        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-semibold">Logout</h5>
            </div>

            <div class="card-body p-4 text-center">

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <h5 class="fw-semibold mb-3">Are you sure?</h5>

                    <p class="text-muted mb-4">
                        Are you sure you want to log out of your Password Manager account?
                    </p>

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                          method="post">

                        <button type="submit" class="btn btn-success w-100">
                            Logout
                        </button>
                    </form>
                }
                else
                {
                    <h5 class="fw-semibold mb-3">Successfully Logged Out</h5>

                    <p class="text-muted mb-4">
                        You have successfully logged out of your account.
                    </p>

                    <a href="/Identity/Account/Login"
                       class="btn btn-success w-100">
                        Login Again
                    </a>
                }

            </div>
        </div>

    </div>
</div>