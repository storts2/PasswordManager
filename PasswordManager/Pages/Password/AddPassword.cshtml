@page
@model PasswordManager.Pages.Password.AddPasswordModel

<div class="container d-flex flex-grow-1 justify-content-center align-items-center p-4">
    <div class="col-md-6 col-lg-5">

        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-semibold">Add Password</h5>
            </div>

            <div class="card-body p-4">
                <form method="post" asp-page-handler="New">
                    <div class="mb-3">
                        <label class="form-label fw-semibold"
                               asp-for="NewPassword.Company">
                            Company
                        </label>
                        <input class="form-control"
                               asp-for="NewPassword.Company" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold"
                               asp-for="NewPassword.Password">
                            Password
                        </label>
                        <input class="form-control"
                               asp-for="NewPassword.Password" />
                    </div>

                    <button type="submit" class="btn btn-success w-100">
                        Add Password
                    </button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-3">
                <h6 class="fw-semibold mb-2">Status</h6>
                <p class="text-muted mb-0">@Model.Message</p>
            </div>
        </div>

    </div>
</div>