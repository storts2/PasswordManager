@page
@model PasswordManager.Pages.Password.IndexModel

<div class="d-flex flex-row">
    <div class="flex-grow-1">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col" class="py-3 ps-4">Company</th>
                    <th scope="col" class="py-3">Password</th>
                    <th scope="col" class="py-3 text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Passwords)
                {
                    <tr>
                        <td class="fw-semibold ps-4">@p.Company</td>
                        <td class="fw-semibold ps-4">@p.Password</td>
                        <td class="text-end pe-4">
                            <form method="post">
                                <div>
                                    <input asp-for="CurrentId" type="hidden" value="@p.Id" />
                                </div>
                                <button type="submit" class="btn btn-success btn-sm">Edit</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="flex-grow-1 border">
        <p>HELLO</p>
    </div>
</div>